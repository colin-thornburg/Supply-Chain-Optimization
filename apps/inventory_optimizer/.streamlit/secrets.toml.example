# Copy to secrets.toml and fill in. Do not commit secrets.toml.

[snowflake]
account = "YOUR_ACCOUNT"
user = "YOUR_USER"
password = "YOUR_PASSWORD"
warehouse = "TRANSFORMING"
role = "TRANSFORMER"
database = "MERIDIAN_SUPPLY_CHAIN"
schema = "MARTS"

[semantic_layer]
# dbt Cloud Semantic Layer GraphQL endpoint, without a trailing path.
host = "https://YOUR_ACCOUNT.semantic-layer.cloud.getdbt.com"
environment_id = "00000"
token = "YOUR_DBT_CLOUD_SERVICE_TOKEN"
